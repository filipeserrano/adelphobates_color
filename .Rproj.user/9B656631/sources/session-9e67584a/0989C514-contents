setwd("C:/Users/camil/Downloads")
coordenadas <- read.csv("Coloração - Página1 (4).csv", stringsAsFactors = FALSE)
source("tabela juntada.R")

names(coordenadas)

coordenadas <- coordenadas %>%
  rename(ID= indivíduo) %>%
  dplyr::select(ID, latitude, longitude, morfotipo)%>%
  mutate(latitude=as.numeric(gsub(",", ".",latitude)), longitude = as.numeric(gsub(",", ".", longitude)), latitude = case_when(ID == 99 ~ -9.58445,ID == 100 ~ -7.09264,TRUE ~ latitude),longitude = case_when(ID == 99 ~ -55.92094,ID == 100 ~ -48.20129,TRUE ~ longitude))

coordenadas$ID <- as.character(coordenadas$ID)
 
tabela_final <- tabela_final %>%
  left_join(coordenadas, by = "ID")

write.csv2(tabela_final, "tabela_completa.csv", row.names = FALSE)

dados_long <- tabela_final %>%
  pivot_longer(cols = starts_with("X3.Forest_"), names_to = "Year", values_to =  "Forest_Cover", names_pattern = "Forest_(\\d+)")

dados_long = dados_long %>%
  mutate(latitude=latitude + runif(n(), -1e-7,1e-7),longitude=longitude+(runif(n(),-1e-7,1e-7)))%>%
  mutate(morfotipo=trimws(morfotipo))

dados_long$Year <- as.numeric(gsub("X3.Forest_", "", dados_long$Year))

dados_filtrados <- dados_long %>%
  filter(morfotipo != "wine", !is.na(morfotipo))

ggplot(dados_filtrados, aes(x= Year , y= Forest_Cover, color=morfotipo))+
  geom_smooth(se = FALSE, linewidth = 1.2, method = "glm")+
  theme_classic()+
  scale_color_manual(values = c ("black","dimgrey", "darkgreen", "blue", "orange", "red", "darkgrey", "yellow", "goldenrod"))

library(janitor)
library(nlme)

tabela_landuse = dados_filtrados%>%
  dplyr::mutate(latitude=as.numeric(gsub(",",".", latitude)),longitude=as.numeric(gsub(",",".", longitude)))%>%
  dplyr::distinct(latitude, longitude, .keep_all = TRUE)

lme_spatial = lme(Forest_Cover ~ -1 + Year* morfotipo, random = ~1|ID, correlation = corExp(form = ~longitude+latitude, nugget = TRUE), data = tabela_landuse)

summary(lme_spatial)

library(emmeans)

slopes = emtrends(lme_spatial, ~morfotipo, var="Year")
summary(slopes)

slopes_df = as.data.frame(summary(slopes))

ggplot(slopes_df, aes(x = reorder(morfotipo, Year.trend), y= Year.trend))+
  geom_pointrange(aes(ymin=lower.CL, ymax= upper.CL),color="darkred")+
  geom_hline(yintercept = 0, linetype= "dashed")+
  coord_flip()+
  labs(title = "",
       subtitle = "",
       x= "Morphotype",
       y= "Annual Change (Units/Year)")+
  theme_classic()

